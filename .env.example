APP_NAME=CommandOS
APP_ENV=development
VOICEBRIDGE_ENV_VERSION=2026-06-07
PRIMARY_DEMO_VERTICAL=fintech_incidents
DEMO_TENANT_ID=atlaspay
DEMO_USER_ID=ayush_demo
DEMO_CASE_ID=sev1_tx_payments_2026_06_07

# LiveKit core call path
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN=
# Room name shared by the web app and the voice agent.
VOICEBRIDGE_ROOM=voicebridge-demo
# Agent name - MUST match between the worker (agent.py) and the browser dispatch
# (web/src/app/api/token/route.ts) or the dispatched agent never joins.
COMMANDOS_AGENT_NAME=commandos_live
# Voice loop: 1 = OpenAI Realtime (gpt-realtime-2, default); 0 = legacy
# STT->LLM->TTS pipeline (rollback).
COMMANDOS_REALTIME=1
# Native web search (Exa) for the agent's web_search tool. Skipped if unset.
EXA_API_KEY=

# LiveKit real outbound calling. Required only for SIP/phone demo.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_DISPATCH_RULE_ID=
DEMO_OUTBOUND_PHONE_NUMBER=

# MOSS memory and retrieval
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=voicebridge_business_knowledge
MOSS_MEMORY_INDEX_NAME=voicebridge_communication_memory
MOSS_MODEL_ID=moss-minilm

# Real payment telemetry for CommandOS 3D map / failure graph.
# Must return JSON with a non-empty `hotspots` or `failures` array.
COMMANDOS_PAYMENTS_API_URL=
COMMANDOS_PAYMENTS_API_KEY=
COMMANDOS_PAYMENTS_DATASET_ID=

# UnSiloed document parsing
UNSILOED_API_KEY=
UNSILOED_PARSE_URL=https://prod.visionapi.unsiloed.ai/parse

# TrueFoundry gateway and guardrails
TRUEFOUNDRY_API_KEY=
TRUEFOUNDRY_GATEWAY_BASE_URL=
TRUEFOUNDRY_GUARDRAIL_CONFIG_ID=
TRUEFOUNDRY_MODEL=

# MiniMax low-latency TTS
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-hd

# ElevenLabs low-latency TTS fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Alibaba/Qwen multilingual reasoning
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_MULTIMODAL_MODEL=qwen-vl-plus

# AWS deployment and audit persistence
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_AUDIT_TABLE=voicebridge_audit_events

# Optional fallback / existing key
NVIDIA_NEMOTRON_VOICECHAT_API_KEY=
